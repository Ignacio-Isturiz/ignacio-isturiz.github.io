---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Project {
	name: string;
	description?: string;
	image?: string;
	images?: string[];
	github?: string;
	url?: string;
	appstore?: string;
}

const projects: Project[] = [
	{
		name: 'Usalo',
		description: 'Plataforma de alquiler de productos en Colombia que conecta a personas que necesitan artículos con quienes los tienen disponibles. Permite publicar, buscar y alquilar todo tipo de productos de forma rápida y segura.',
		image: `${base}/logousalo.png`,
		url: 'https://usaloapp.com/',
	},
	{
		name: 'Luca: finanzas personales',
		description: 'App iOS de finanzas personales para el contexto venezolano. Registra ingresos y gastos en segundos con conversión automática USD/VES. Los datos se guardan en tu dispositivo y se sincronizan con iCloud — privacidad total, funciona sin internet.',
		image: `${base}/logoluca.png`,
		appstore: 'https://apps.apple.com/us/app/luca-finanzas-personales/id6762027713',
		url: 'https://www.mislucas.app/',
	},
	{
		name: 'GeoMed',
		description: 'Proyecto ganador DataHack 2026 Pascual Bravo. Plataforma de información ciudadana para Medellín que combina IA, análisis de datos y seguridad. Incluye feed de noticias, chatbot de recomendaciones por zonas, mapas interactivos y módulo de servicios públicos. Stack: FastAPI + React + Docker.',
		images: [`${base}/geomed-logo.png`, `${base}/geomed-1.png`, `${base}/geomed-2.png`],
		github: 'https://github.com/Ignacio-Isturiz/GeoMed',
	},
	{
		name: 'ScoutOps',
		description: 'Agente SRE de triaje de incidentes construido para el AgentX Hackathon 2026. Pipeline de 6 nodos en LangGraph que convierte reportes en trabajo accionable: diagnóstico con RAG, apertura automática de issues en GitHub, tickets en Jira y alertas por Slack. Stack: FastAPI, Gemini 2.5 Flash, ChromaDB, Next.js.',
		github: 'https://github.com/Karlyvelasquez/ScoutOps',
		url: 'https://youtu.be/stqzDbP8vUY?si=tODwDl1ZeBgnpKAq',
	},
	{
		name: 'CampusGo',
		github: 'https://github.com/Ignacio-Isturiz/campusgo',
	},
	{
		name: 'MECIA',
		description: 'Plataforma con IA para emprendedores y ciudadanos en Medellín. Ofrece dashboard personalizado, chatbot de seguridad, mapas interactivos y análisis de datos. Stack: FastAPI + React 18 + Tailwind + Docker.',
		images: [`${base}/mecia-1.png`, `${base}/mecia-2.png`, `${base}/mecia-3.png`, `${base}/mecia-4.png`],
		github: 'https://github.com/Ignacio-Isturiz/MECIA',
	},
	{
		name: 'Platon',
		description: 'Plataforma de IA para docentes que transforma ideas de clase en planificaciones inclusivas basadas en el Diseño Universal para el Aprendizaje (DUA) y el ciclo pedagógico 5E. Stack: Next.js + TypeScript + FastAPI.',
		github: 'https://github.com/Ignacio-Isturiz/platon',
	},
	{ name: 'Agente WhatsApp Usalo' },
];

const githubIcon = '<path d="M9 19c-4 1.5-4-2-6-2m12 4v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.7 11.7 0 0 0-6 0C6.5 2.7 5.5 3 5.5 3a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.8 5.6 5.5 6a3 3 0 0 0-.8 2.3V21"/>';
const externalIcon = '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/>';
const appstoreIcon = '<path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm-1.5 14.5l-4-6.928 1.732-1 2.268 3.928 2.268-3.928 1.732 1-4 6.928zm6.5.5h-2V9h2v8z"/>';
---

<section id="proyectos" class="projects">
	<div class="container">
		<h2>Proyectos destacados</h2>

		<ol class="list">
			{projects.map((p) => (
				<li class="item">
					<article class="card">
						<div class="media">
							{p.images && p.images.length > 0
								? (
									<div class="carousel" data-carousel>
										<div class="carousel-track">
											{p.images.map((src, i) => (
												<img src={src} alt={`${p.name} ${i + 1}`} class="carousel-slide" />
											))}
										</div>
										{p.images.length > 1 && (
											<>
												<button class="carousel-btn prev" aria-label="Anterior">&#8249;</button>
												<button class="carousel-btn next" aria-label="Siguiente">&#8250;</button>
												<div class="carousel-dots">
													{p.images.map((_, i) => (
														<span class={`dot${i === 0 ? ' active' : ''}`} data-index={i} />
													))}
												</div>
											</>
										)}
									</div>
								)
								: p.image
									? <img src={p.image} alt={p.name} class="thumb-img" />
									: <div class="thumb"><span>Imagen</span></div>
							}
							<div class="bar">
								{p.github && (
									<a href={p.github} target="_blank" rel="noopener noreferrer" class="ico" aria-label="Repositorio GitHub">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={githubIcon} />
									</a>
								)}
								{p.appstore && (
									<a href={p.appstore} target="_blank" rel="noopener noreferrer" class="ico" aria-label="Descargar en App Store">
										<img src="https://img.icons8.com/?size=100&id=fKXXelWgP1B6&format=png&color=000000" width="16" height="16" alt="App Store" class="ico-img" />
									</a>
								)}
								{p.url && (
									<a href={p.url} target="_blank" rel="noopener noreferrer" class="ico" aria-label="Ver proyecto">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={externalIcon} />
									</a>
								)}
								{!p.github && !p.url && !p.appstore && (
									<>
										<span class="ico" aria-hidden="true">
											<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={githubIcon} />
										</span>
										<span class="ico" aria-hidden="true">
											<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={externalIcon} />
										</span>
									</>
								)}
							</div>
						</div>

						<div class="body">
							<h3>{p.name}</h3>
							{p.description
								? <p class="desc">{p.description}</p>
								: <div class="skeleton" role="presentation">
										<span style="--w:92%"></span>
										<span style="--w:98%"></span>
										<span style="--w:85%"></span>
										<span style="--w:95%"></span>
										<span style="--w:70%"></span>
									</div>
							}
						</div>
					</article>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.projects {
		padding: 4rem 0 6rem;
		background: var(--bg);
	}
	.container {
		width: min(1100px, 100% - 3rem);
		margin-inline: auto;
	}
	h2 {
		margin: 0 0 3.5rem;
		font-size: clamp(2.2rem, 6vw, 4rem);
		text-align: center;
		background: linear-gradient(180deg, var(--text), color-mix(in srgb, var(--muted) 60%, transparent));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		/* Evita que el degradado recorte los trazos altos de la fuente. */
		display: inline-block;
		width: 100%;
		padding: 0.1em 0;
	}
	.list {
		display: grid;
		gap: 3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
		align-items: center;
		opacity: 0;
		filter: blur(8px);
		transform: translateY(16px);
	}
	.item.in-view .card {
		animation: reveal 1s ease forwards;
	}
	.item:nth-child(even) .media {
		order: 2;
	}
	.media {
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 1rem;
		background: var(--surface);
	}
	.thumb {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		background: color-mix(in srgb, var(--muted) 12%, transparent);
	}
	.thumb span {
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.thumb-img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		display: block;
	}
	.carousel {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 10;
	}
	.carousel-track {
		display: flex;
		width: 100%;
		height: 100%;
		transition: transform 0.4s ease;
	}
	.carousel-slide {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.carousel-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		border: 1px solid var(--border);
		color: var(--text);
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		cursor: pointer;
		font-size: 1.2rem;
		line-height: 1;
		display: grid;
		place-items: center;
		transition: background 0.2s;
		z-index: 2;
	}
	.carousel-btn:hover {
		background: color-mix(in srgb, var(--bg) 90%, transparent);
	}
	.carousel-btn.prev { left: 0.5rem; }
	.carousel-btn.next { right: 0.5rem; }
	.carousel-dots {
		position: absolute;
		bottom: 0.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.4rem;
		z-index: 2;
	}
	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--text) 40%, transparent);
		cursor: pointer;
		transition: background 0.2s;
	}
	.dot.active {
		background: var(--text);
	}
	.desc {
		margin: 0;
		color: var(--muted);
		line-height: 1.75;
		font-size: 0.95rem;
	}
	.bar {
		display: flex;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		border-top: 1px solid var(--border);
	}
	.ico {
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 0.5rem;
		color: var(--muted);
		background: color-mix(in srgb, var(--muted) 10%, transparent);
	}
	.ico-img {
		display: block;
	}
	:root[data-theme="dark"] .ico-img {
		filter: invert(1);
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) .ico-img {
			filter: invert(1);
		}
	}
	.body h3 {
		margin: 0 0 1.5rem;
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.2;
	}
	.skeleton {
		display: grid;
		gap: 0.85rem;
	}
	.skeleton span {
		display: block;
		width: var(--w, 100%);
		height: 0.7rem;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--muted) 14%, transparent) 25%,
			color-mix(in srgb, var(--muted) 26%, transparent) 50%,
			color-mix(in srgb, var(--muted) 14%, transparent) 75%
		);
		background-size: 200% 100%;
		animation: shimmer 1.8s linear infinite;
	}
	@keyframes shimmer {
		to {
			background-position: -200% 0;
		}
	}
	@keyframes reveal {
		to {
			opacity: 1;
			filter: blur(0);
			transform: none;
		}
	}
	@media (max-width: 720px) {
		.card {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		/* Siempre: nombre primero, imagen al final */
		.card .body {
			order: 1;
		}
		.card .media {
			order: 2;
		}
		.item:nth-child(even) .media {
			order: 2;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			animation: none !important;
			opacity: 1;
			filter: none;
			transform: none;
		}
		.skeleton span {
			animation: none;
		}
	}
</style>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((e) => e.isIntersecting && e.target.classList.add('in-view'));
		},
		{ threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
	);
	document.querySelectorAll('.projects .item').forEach((el) => observer.observe(el));

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>('.carousel-track')!;
		const dots = carousel.querySelectorAll<HTMLElement>('.dot');
		let current = 0;
		const total = dots.length;

		function goTo(index: number) {
			current = (index + total) % total;
			track.style.transform = `translateX(-${current * 100}%)`;
			dots.forEach((d, i) => d.classList.toggle('active', i === current));
		}

		carousel.querySelector('.prev')?.addEventListener('click', () => goTo(current - 1));
		carousel.querySelector('.next')?.addEventListener('click', () => goTo(current + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
	});
</script>
