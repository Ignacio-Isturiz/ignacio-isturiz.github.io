---
const icons: Record<string, string> = {
	terminal: '<path d="m4 17 6-6-6-6M12 19h8"/>',
	ai: '<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3M9.5 15l2.5-6 2.5 6M10.3 13h3.4"/>',
	server: '<rect x="2" y="3" width="20" height="8" rx="2"/><rect x="2" y="13" width="20" height="8" rx="2"/><path d="M6 7h.01M6 17h.01"/>',
	database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/>',
	cloud: '<path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 0 0 4.5 12 3.5 3.5 0 0 0 6 19z"/>',
};

const groups = [
	{
		icon: 'terminal',
		title: 'Lenguajes',
		desc: 'Base técnica para construir servicios, integraciones y aplicaciones.',
		items: ['Python', 'JavaScript', 'C#', 'PHP', 'Kotlin', 'Java'],
	},
	{
		icon: 'server',
		title: 'Backend y frontend',
		desc: 'Desarrollo de aplicaciones completas, APIs y lógica de negocio.',
		items: ['Django', 'Flask', 'Next.js', 'React Native', 'ASP.NET', 'Laravel'],
	},
	{
		icon: 'ai',
		title: 'Inteligencia artificial',
		desc: 'Modelos de lenguaje, recuperación aumentada y aprendizaje automático aplicados a problemas reales.',
		items: ['LLMs', 'Machine Learning', 'RAG', 'LangChain', 'Embeddings', 'pgvector'],
	},
	{
		icon: 'cloud',
		title: 'Infraestructura y DevOps',
		desc: 'Despliegue de aplicaciones en servidores y entornos cloud, con control de versiones.',
		items: ['Linux', 'Docker', 'Git', 'GitHub', 'Despliegue en servidores y cloud'],
	},
	{
		icon: 'database',
		title: 'Bases de datos y herramientas',
		desc: 'Modelado y gestión de datos, soluciones empresariales y pruebas de integraciones.',
		items: ['PostgreSQL', 'SQL', 'Odoo', 'Postman', 'Meta API', 'SonarCloud'],
	},
];
---

<section id="stack" class="stack">
	<div class="container">
		<h2>Stack</h2>
		<p class="lead">
			Tecnologías con las que diseño, construyo e implemento soluciones de software, IA e
			infraestructura.
		</p>

		<ul class="grid">
			{groups.map((g) => (
				<li class="item">
					<article class="card">
						<header>
							<span class="ico" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[g.icon]} />
							</span>
							<div>
								<h3>{g.title}</h3>
								<p>{g.desc}</p>
							</div>
						</header>
						<ul class="chips">
							{g.items.map((i) => <li>{i}</li>)}
						</ul>
					</article>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.stack {
		padding: 4rem 0 6rem;
		background: var(--bg);
	}
	.container {
		width: min(1100px, 100% - 3rem);
		margin-inline: auto;
	}
	h2 {
		margin: 0 0 1rem;
		font-size: clamp(2.2rem, 6vw, 4rem);
		text-align: center;
		background: linear-gradient(180deg, var(--text), color-mix(in srgb, var(--muted) 60%, transparent));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		/* Evita que el degradado recorte los trazos altos de la fuente. */
		display: inline-block;
		width: 100%;
		padding: 0.1em 0;
	}
	.lead {
		max-width: 52ch;
		margin: 0 auto 3.5rem;
		text-align: center;
		color: var(--muted);
		line-height: 1.7;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Con 5 tarjetas la última queda sola: la centramos en la fila. */
	.item:last-child {
		grid-column: 1 / -1;
		width: calc(50% - 0.875rem);
		justify-self: center;
	}
	.card {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding: 1.75rem;
		border: 1px solid var(--border);
		border-radius: 1.25rem;
		background: var(--surface);
		opacity: 0;
		filter: blur(8px);
		transform: translateY(16px);
		transition: transform 0.25s, box-shadow 0.25s;
	}
	.item.in-view .card {
		animation: reveal 0.9s ease forwards;
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow);
	}
	header {
		display: flex;
		gap: 1.1rem;
		align-items: flex-start;
	}
	.ico {
		flex: none;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 0.9rem;
		background: var(--accent);
		color: var(--on-accent);
	}
	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.35rem;
		line-height: 1.2;
	}
	header p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: auto 0 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--text);
	}
	@keyframes reveal {
		to {
			opacity: 1;
			filter: blur(0);
			transform: none;
		}
	}
	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.item:last-child {
			width: 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			animation: none !important;
			opacity: 1;
			filter: none;
			transform: none;
		}
	}
</style>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((e) => e.isIntersecting && e.target.classList.add('in-view'));
		},
		{ threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
	);
	document.querySelectorAll('.stack .item').forEach((el) => observer.observe(el));
</script>
